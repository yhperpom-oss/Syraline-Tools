# Copy to .env (or export these in your shell / hosting panel) before running.

# Shared HMAC secret. MUST equal the client's SYRALINE_LICENSE_SECRET
# (SyraLine/lib/license_config.py). Use a long random value.
LICENSE_SECRET=change-me-shared-secret-please

# Admin token required by every /admin/* endpoint (header X-Admin-Token).
ADMIN_TOKEN=change-me-admin-token

# Optional: path to the SQLite database file (default: ./licenses.db)
# SYRALINE_DB=/var/lib/syraline/licenses.db
